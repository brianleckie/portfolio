---
import { render } from 'astro:content';
import { caseHref, homeHref, localeOf } from '../../i18n/routes';
import { t } from '../../i18n/ui';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import DevicePair from '../../components/DevicePair.astro';
import ProjectDiagram from '../../components/ProjectDiagram.astro';
import WhatsAppLink from '../../components/WhatsAppLink.astro';
import {
  descriptionOf, getProjects, projectWhatsappHref, shortTitle, subtitleOf, slugOf, summaryOf, type Project,
} from '../../lib/projects';
import { projectFullImages, projectImages } from '../../lib/project-images';
import { clean, cleanList } from '../../lib/todo';
import { site } from '../../config/site';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((entry, i) => ({
    params: { slug: slugOf(entry) },
    props: { entry, prev: projects[i - 1], next: projects[i + 1] },
  }));
}

interface Props { entry: Project; prev?: Project; next?: Project }
const { entry, prev, next } = Astro.props;
const locale = localeOf(Astro.currentLocale);
const ui = t(locale);
const ed = ui.editorial;
const { data } = entry;
const { Content } = await render(entry);
const slug = slugOf(entry);
const title = shortTitle(entry);
const subtitle = subtitleOf(entry);
const summary = summaryOf(entry);
const role = clean(data.role);
const stack = cleanList(data.stack);
const client = data.clientNamePublic && clean(data.client);
const highlights = cleanList(data.highlights);
const results = cleanList(data.results);
const demo = clean(data.demoUrl);
const repo = clean(data.repoUrl);
const links = [
  ...(demo ? [{ label: ui.viewDemo, url: demo }] : []),
  ...(data.links ?? []).filter(({ label, url }) => clean(label) && clean(url))
    .map(({ label, url }) => ({ label: ui.view + ' ' + label + ' ↗', url })),
  ...(repo ? [{ label: ui.viewCode, url: repo }] : []),
];
const variants = slug === 'floreria-catalogo'
  ? [{ title: ed.rocio, variant: 'rocio' }, { title: ed.ornella, variant: 'ornella' }]
  : [{ title, variant: undefined }];
const gallery = variants.flatMap(({ title, variant }) => [false, true].map((alternate) => ({
  ...projectImages(entry, { variant, alternate }),
  full: alternate ? undefined : projectFullImages(entry,
    slug === 'floreria-catalogo' && variant === 'rocio' ? { desktop: 'ornella', mobile: 'rocio' } :
      { desktop: variant, mobile: variant }),
  label: alternate ? title + ' · ' + ed.alternate : title,
}))).filter(({ desktop, mobile }) => desktop || mobile);
---

<BaseLayout title={`${title} — ${site.name}`} description={descriptionOf(entry, locale)}
  ogImage={`/og/${slug}.png`} ogImageAlt={`${data.title} — ${ui.caseStudyBy} ${site.name}`} type="article" {locale}>
  <Header {slug} />
  <main class="wrap article" data-project={slug} data-status={data.status}>
    <section class="article-hero" aria-labelledby="case-title">
      <div class="sec-head">
        <a class="link-arrow" href={homeHref(locale) + '#trabajos'}>{ui.allProjectsBack}</a>
        <span class="status mono">{ui.status[data.status]}</span>
      </div>
      <h1 id="case-title">{title}</h1>
      {subtitle && <p class="article-subtitle">{subtitle}</p>}
      {summary && <p class="article-lead">{summary}</p>}
      <dl class="article-meta mono">
        <div><dt class="label">{ui.statusLabel}</dt><dd>{ui.status[data.status]}</dd></div>
        {role && <div><dt class="label">{ui.role}</dt><dd>{role}</dd></div>}
        {stack.length > 0 && <div><dt class="label">{ui.stack}</dt><dd>{stack.join(' · ')}</dd></div>}
        {client && <div><dt class="label">{ed.client}</dt><dd>{client}</dd></div>}
      </dl>
      {links.length > 0 && (
        <ul class="article-links" role="list">
          {links.map(({ label, url }) => <li><a class="link-arrow" href={url} target="_blank" rel="noopener">{label}</a></li>)}
        </ul>
      )}
    </section>

    {gallery.length > 0 && (
      <div class="gallery">
        {gallery.map(({ desktop, mobile, label, full }, i) => (
          <figure>
            <DevicePair desktop={full?.desktop ?? desktop} mobile={full?.mobile ?? mobile}
              fullDesktop={Boolean(full?.desktop)} fullMobile={Boolean(full?.mobile)} title={label} accent={data.accent} />
            <figcaption class="fig mono">{ed.figure} {String(i + 1).padStart(2, '0')} · {label}</figcaption>
          </figure>
        ))}
      </div>
    )}
    {data.flow && <div class="article-diagram"><ProjectDiagram flow={data.flow} /></div>}

    <div class="article-content">
      <div class="prose"><Content /></div>
      {(highlights.length > 0 || results.length > 0) && (
        <aside class="article-notes">
          {highlights.length > 0 && <div><h2>{ui.highlights}</h2><ul>{highlights.map((h) => <li>{h}</li>)}</ul></div>}
          {results.length > 0 && <div><h2>{ui.results}</h2><ul>{results.map((r) => <li>{r}</li>)}</ul></div>}
        </aside>
      )}
    </div>

    <section class="article-cta" id="caso-cta" aria-labelledby="cta-title">
      <h2 class="h2" id="cta-title">{ui.caseCta}</h2>
      <p>{ui.caseCtaBody}</p>
      <WhatsAppLink href={projectWhatsappHref(entry, locale)} />
    </section>
    <nav class="pager" aria-label={ui.otherProjects}>
      {prev && <a href={caseHref(slugOf(prev), locale)} rel="prev"><span class="label">{ui.previous}</span>{shortTitle(prev)}</a>}
      {next && <a href={caseHref(slugOf(next), locale)} rel="next"><span class="label">{ui.next}</span>{shortTitle(next)}</a>}
    </nav>
  </main>
  <Footer />
</BaseLayout>

<style>
  .article { --acc: var(--ink); padding-block: var(--space-lg); }
  .article-hero h1 {
    font-size: clamp(50px, 9vw, 136px);
    letter-spacing: -.055em;
    line-height: .94;
    margin-block: var(--space-md);
    overflow-wrap: anywhere;
  }
  .article-subtitle { font-size: clamp(22px, 3vw, 36px); line-height: 1.2; }
  .article-lead { margin-top: var(--space-sm); max-width: 57ch; color: var(--ink-2); }
  .article-meta {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-sm) var(--space-md);
    border-block: 1px solid var(--rule);
    padding-block: var(--space-sm);
    margin-block: var(--space-md) 0;
    overflow-wrap: anywhere;
  }
  .article-links { display: flex; flex-wrap: wrap; gap: 0 var(--space-md); margin: 0; padding: 0; list-style: none; }
  .gallery, .article-diagram, .article-content { margin-block: var(--space-lg); }
  .gallery { display: grid; gap: var(--space-md); }
  .article-diagram { max-width: 900px; }
  .article-content { display: grid; gap: var(--space-lg); }
  .prose { max-width: 67ch; line-height: 1.65; overflow-wrap: anywhere; }
  .prose :global(h2), .article-notes h2 { font-size: clamp(24px, 4vw, 38px); line-height: 1.13; letter-spacing: -.035em; }
  .prose :global(h2:not(:first-child)) { margin-top: var(--space-lg); }
  .prose :global(p), .prose :global(ul) { margin-top: var(--space-sm); }
  .prose :global(ul), .article-notes ul { padding-inline-start: 20px; }
  .prose :global(a) { display: inline-flex; align-items: center; min-height: 44px; }
  .prose :global(code) { font-family: var(--mono); background: var(--paper-2); }
  .prose :global(blockquote) { margin-inline: 0; padding: var(--space-sm); border-left: 2px solid var(--ink); }
  .article-notes { border-top: 1px solid var(--rule); padding-top: var(--space-md); }
  .article-notes > div + div { margin-top: var(--space-md); }
  .article-cta { border-top: 1px solid var(--ink); padding-block: var(--space-md) var(--space-lg); }
  .article-cta h2 { max-width: 17ch; }
  .article-cta p { margin-top: var(--space-sm); }
  .article-cta .btn-wa { margin-top: var(--space-md); }
  .pager { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); border-top: 1px solid var(--rule); gap: var(--space-sm); }
  .pager a { display: grid; align-content: start; min-height: 44px; padding-block: var(--space-sm); text-decoration: none; }
  .pager a:hover { text-decoration: underline; }
  .pager a[rel="next"] { grid-column: 2; text-align: right; }
  @media (min-width: 1024px) {
    .article-meta { grid-template-columns: repeat(4, minmax(0, 1fr)); padding-block: var(--space-md); }
    .article-content { grid-template-columns: var(--grid); gap: var(--column-gap); }
    .prose { grid-column: 1 / span 7; }
    .article-notes { grid-column: 9 / span 4; }
  }
</style>
