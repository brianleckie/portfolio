---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import ProjectGrid from '../components/ProjectGrid.astro';
import { site } from '../config/site';
---

<BaseLayout
  title={`${site.name} — ${site.role}`}
  description={`Portfolio de ${site.name}. ${site.role} en ${site.location}.`}
>
  <Header />
  <main>
    <Hero />

    <ProjectGrid />

    <section id="servicios" style="padding: 4rem var(--pad-desktop); background: var(--color-bg-hero-from); max-width: 100%;">
      <div style="max-width: var(--max-w); margin: 0 auto;">
        <h2 style="font-family: 'Satoshi', system-ui, sans-serif; font-weight: 900; font-size: 2rem; color: var(--color-text-primary);">
          Servicios — Fase 3
        </h2>
      </div>
    </section>

    <section id="proceso" style="padding: 4rem var(--pad-desktop); max-width: var(--max-w); margin: 0 auto;">
      <h2 style="font-family: 'Satoshi', system-ui, sans-serif; font-weight: 900; font-size: 2rem; color: var(--color-text-primary);">
        Proceso — Fase 3
      </h2>
    </section>

    <section id="sobre-mi" style="padding: 4rem var(--pad-desktop); max-width: var(--max-w); margin: 0 auto;">
      <h2 style="font-family: 'Satoshi', system-ui, sans-serif; font-weight: 900; font-size: 2rem; color: var(--color-text-primary);">
        Sobre mí — Fase 3
      </h2>
    </section>

    <section id="contacto" style="padding: 4rem var(--pad-desktop); background: var(--color-bg-contact); width: 100%;">
      <div style="max-width: var(--max-w); margin: 0 auto;">
        <h2 style="font-family: 'Satoshi', system-ui, sans-serif; font-weight: 900; font-size: 2rem; color: var(--color-text-contact);">
          Contacto — Fase 3
        </h2>
      </div>
    </section>
  </main>
</BaseLayout>
