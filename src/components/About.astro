---
import { t } from '../i18n/ui';
import { localeOf } from '../i18n/routes';
import { site, resolveValue } from '../config/site';

const github = resolveValue(site.github);
const linkedin = resolveValue(site.linkedin);

const ui = t(localeOf(Astro.currentLocale));
const stack = [
  { group: ui.frontend, items: ['Vue 3', 'Quasar', 'React', 'Vite', 'TypeScript'] },
  { group: ui.backend, items: ['Python', 'FastAPI', 'PostgreSQL', 'Supabase'] },
  { group: ui.infra, items: ['Railway', 'Vercel', 'Cloudinary', 'GitHub Actions', 'n8n'] },
];
---

<section id="sobre-mi" class="section tint" aria-labelledby="sobre-mi-title">
  <div class="section-inner layout">
    <div class="text">
      {site.photo && <img src={site.photo} alt={site.name} />}
      <h2 id="sobre-mi-title" class="section-title">{ui.about}</h2>
      <p>{ui.aboutBody}</p>
      <p>{ui.languages}</p>

      {(github || linkedin) && (
        <p class="links">
          {github && <a href={github} target="_blank" rel="noopener noreferrer">GitHub ↗</a>}
          {linkedin && <a href={linkedin} target="_blank" rel="noopener noreferrer">LinkedIn ↗</a>}
        </p>
      )}
    </div>

    <div id="stack" class="stack" aria-labelledby="stack-title">
      <h3 id="stack-title">{ui.stack}</h3>
      <div class="groups">
        {stack.map((g) => (
          <div class="group">
            <h4>{g.group}</h4>
            <ul class="chips">
              {g.items.map((item) => <li>{item}</li>)}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .tint {
    background-color: var(--color-bg-hero-to);
  }

  .layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--space-xl) var(--space-2xl);
    align-items: start;
  }

  .text {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .text p {
    max-width: 52ch;
    font-size: clamp(1.0625rem, 1.5vw, 1.25rem);
    line-height: 1.65;
    color: var(--color-text-primary);
  }

  .text .section-title {
    margin-bottom: var(--space-sm);
  }

  .links {
    display: flex;
    gap: var(--space-md);
  }

  .links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding-block: 0.5rem;
    font-weight: 600;
    color: var(--color-accent);
  }

  .stack {
    scroll-margin-top: calc(var(--header-h) + 8px);
    padding: var(--space-lg);
    border: 2px solid #111;
    border-radius: 20px;
    background: #fff;
    box-shadow: 0 5px 0 #000;
  }

  .stack h3 {
    margin-bottom: var(--space-md);
    font-family: 'Satoshi', system-ui, sans-serif;
    font-weight: 900;
    font-size: 1.5rem;
    letter-spacing: -0.02em;
  }

  .groups {
    display: grid;
    gap: var(--space-md);
  }

  .group h4 {
    margin-bottom: 0.4rem;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
  }

  @media (max-width: 899px) {
    .layout {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 699px) {
    .stack {
      padding: var(--space-md);
    }
  }
</style>
