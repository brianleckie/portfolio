---
import { caseHref, homeHref, localeOf } from '../i18n/routes';
import { t } from '../i18n/ui';
import { site, whatsappHref } from '../config/site';
import LanguageSelector from './LanguageSelector.astro';

interface Props { slug?: string }
const { slug } = Astro.props;
const locale = localeOf(Astro.currentLocale);
const ui = t(locale);
const home = homeHref(locale);
const prefix = slug ? home : '';
const wa = whatsappHref(undefined, locale);
const sections = [
  ['trabajos', ui.editorial.work],
  ['experiencia', ui.experience],
  ['servicios', ui.process],
  ['contacto', ui.contact],
];
---

<header class="hdr">
  <div class="wrap">
    <a class="brand" href={slug ? home : '#top'} aria-label={ui.editorial.homeLabel}>{site.wordmark.slice(0, -1)}<span>.</span></a>
    <nav class="nav" aria-label={ui.primaryNav}><span class="nav-indicator" aria-hidden="true"></span>
      {sections.map(([id, label]) => <a href={prefix + '#' + id}>{label}</a>)}
    </nav>
    <div class="hdr-r">
      {site.enableEnglish && <LanguageSelector {locale} alternates={{
        es: slug ? caseHref(slug, 'es') : homeHref('es'),
        en: slug ? caseHref(slug, 'en') : homeHref('en'),
      }} />}
      {!slug && <a class="hdr-wa" data-header-wa href={wa} target="_blank" rel="noopener" hidden>WhatsApp</a>}
      <button class="menu-toggle" type="button" aria-controls="mobile-menu" aria-expanded="false" hidden>{ui.editorial.menu}</button>
    </div>
  </div>
</header>
<dialog id="mobile-menu" class="mobile-menu" aria-label={ui.editorial.menu}>
  <div class="wrap">
    <form method="dialog"><button autofocus type="submit">{ui.editorial.closeMenu}</button></form>
    <nav aria-label={ui.primaryNav}>
      {sections.map(([id, label]) => <a href={prefix + '#' + id}>{label}</a>)}
    </nav>
    <a class="btn-wa" href={wa} target="_blank" rel="noopener">{ui.whatsappCta}</a>
  </div>
</dialog>

<script>
  const header = document.querySelector('.hdr');
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const menu = document.querySelector<HTMLDialogElement>('#mobile-menu');
  if (toggle && menu) {
    toggle.hidden = false;
    toggle.addEventListener('click', () => {
      menu.showModal();
      toggle.setAttribute('aria-expanded', 'true');
      document.documentElement.classList.add('menu-open');
    });
    menu.addEventListener('close', () => {
      toggle.setAttribute('aria-expanded', 'false');
      document.documentElement.classList.remove('menu-open');
      toggle.focus({ preventScroll: true });
    });
    menu.addEventListener('click', (event) => {
      if (event.target instanceof Element && event.target.closest('a')) menu.close();
    });
    matchMedia('(min-width: 900px)').addEventListener('change', (event) => {
      if (event.matches && menu.open) menu.close();
    });
  }

  const nav = header?.querySelector<HTMLElement>('.nav');
  const links = Array.from(nav?.querySelectorAll<HTMLAnchorElement>('a[href^="#"]') ?? []);
  const sections = links.flatMap((link) => {
    const section = document.getElementById(link.hash.slice(1));
    return section ? [{ link, section }] : [];
  });
  function syncNavigation() {
    header?.classList.toggle('scrolled', scrollY > 0);
    const active = sections.slice().reverse().find(({ section }) => section.getBoundingClientRect().top <= innerHeight * .4)?.link;
    for (const { link } of sections) {
      if (link === active) link.setAttribute('aria-current', 'location');
      else link.removeAttribute('aria-current');
    }
    if (active && nav) {
      nav.style.setProperty('--indicator-x', active.offsetLeft + 'px');
      nav.style.setProperty('--indicator-w', active.offsetWidth + 'px');
    }
    nav?.classList.toggle('has-current', Boolean(active));
  }
  window.addEventListener('scroll', () => header?.classList.toggle('scrolled', scrollY > 0), { passive: true });
  window.addEventListener('resize', syncNavigation);
  const sectionObserver = new IntersectionObserver(syncNavigation, { rootMargin: '0px 0px -60% 0px' });
  sections.forEach(({ section }) => sectionObserver.observe(section));
  syncNavigation();

  const headerLink = header?.querySelector('[data-header-wa]');
  const inlineLinks = document.querySelectorAll('[data-inline-wa]');
  if (header && headerLink && inlineLinks.length) {
    let observer: IntersectionObserver | undefined;
    const observeLinks = () => {
      observer?.disconnect();
      const visible = new Set<Element>();
      const top = header.getBoundingClientRect().height;
      observer = new IntersectionObserver((entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) visible.add(entry.target);
          else visible.delete(entry.target);
        }
        headerLink.toggleAttribute('hidden', visible.size > 0);
      }, { rootMargin: `-${top}px 0px 0px` });
      inlineLinks.forEach((link) => observer?.observe(link));
    };
    new ResizeObserver(observeLinks).observe(header);
  }
</script>
