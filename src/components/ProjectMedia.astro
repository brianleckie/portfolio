---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  title: string;
  accent: string;
  initials: string;
  desktop?: ImageMetadata;
  mobile?: ImageMetadata;
  eager?: boolean;
  variant?: 'card' | 'case';
}

const { title, accent, initials, desktop, mobile, eager = false, variant = 'card' } = Astro.props;
const loading = eager ? 'eager' : 'lazy';
const desktopSizes =
  variant === 'case'
    ? '(min-width: 1100px) 960px, 92vw'
    : '(min-width: 1024px) 560px, (min-width: 700px) 46vw, 92vw';
---

<div
  class="media"
  data-variant={variant}
  data-has-desktop={desktop ? '' : undefined}
  data-has-mobile={mobile ? '' : undefined}
  style={`--accent: ${accent}`}
>
  {desktop && (
    <div class="frame browser">
      <div class="bar" aria-hidden="true"><i></i><i></i><i></i></div>
      <Picture
        src={desktop}
        alt={`Captura de escritorio de ${title}`}
        formats={['avif', 'webp']}
        fallbackFormat="webp"
        widths={[480, 800, 1200]}
        sizes={desktopSizes}
        loading={loading}
        decoding="async"
      />
    </div>
  )}
  {mobile && (
    <div class="frame phone">
      <Picture
        src={mobile}
        alt={`Captura mobile de ${title}`}
        formats={['avif', 'webp']}
        fallbackFormat="webp"
        widths={[240, 360, 480]}
        sizes="(min-width: 700px) 140px, 180px"
        loading={loading}
        decoding="async"
      />
    </div>
  )}
  {!desktop && !mobile && (
    <div class="placeholder" aria-hidden="true"><span>{initials}</span></div>
  )}
</div>

<style>
  .media {
    position: relative;
    display: grid;
    place-items: center;
    padding: 1.5rem;
    border: 2px solid #111;
    border-radius: 20px;
    background-color: var(--accent);
    background-image: linear-gradient(155deg, rgb(255 255 255 / 0.55), rgb(255 255 255 / 0.05));
    overflow: hidden;
  }

  .media[data-variant='card'] {
    aspect-ratio: 16 / 10;
  }

  .frame {
    background: #fff;
    border: 2px solid #111;
    box-shadow: 0 5px 0 #000;
    overflow: hidden;
  }

  .frame :global(picture),
  .frame :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  /* Marco de navegador (captura desktop) */
  .browser {
    width: 100%;
    border-radius: 12px;
  }

  .bar {
    display: flex;
    gap: 5px;
    padding: 7px 10px;
    border-bottom: 2px solid #111;
    background: #f3f3f6;
  }

  .bar i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #111;
    opacity: 0.35;
  }

  /* Marco de teléfono (captura mobile) */
  .phone {
    width: 38%;
    min-width: 96px;
    max-width: 190px;
    border-radius: 18px;
  }

  /* Con ambas capturas, el teléfono se superpone al navegador */
  .media[data-has-desktop][data-has-mobile] .phone {
    position: absolute;
    right: 1.25rem;
    bottom: 1rem;
    width: 22%;
    min-width: 84px;
  }

  .media[data-variant='case'] {
    padding: 2rem;
  }

  /* Placeholder: una "tecla" con las iniciales y el color del proyecto */
  .placeholder {
    display: grid;
    place-items: center;
    width: min(46%, 220px);
    aspect-ratio: 146 / 161;
    border: 2px solid #111;
    border-radius: 29px;
    background: rgb(255 255 255 / 0.55);
    box-shadow: 0 6px 0 #000;
    font-family: 'Satoshi', system-ui, sans-serif;
    font-weight: 900;
    font-size: clamp(3rem, 9vw, 5.5rem);
    letter-spacing: -0.03em;
    line-height: 1;
    color: #111;
  }

  .media[data-variant='case'] .placeholder {
    width: min(30%, 220px);
  }

  @media (max-width: 699px) {
    .media[data-variant='card'] {
      aspect-ratio: auto;
    }

    /* Mobile primero: si existe la captura mobile, es la protagonista */
    .media[data-has-mobile] .browser {
      display: none;
    }

    .media[data-has-desktop][data-has-mobile] .phone,
    .phone {
      position: static;
      width: min(52%, 190px);
    }

    .placeholder {
      width: min(44%, 150px);
    }
  }
</style>
