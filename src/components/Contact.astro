---
import { localeOf } from '../i18n/routes';
import { t } from '../i18n/ui';
import { site, resolveValue } from '../config/site';
import WhatsAppLink from './WhatsAppLink.astro';

const ed = t(localeOf(Astro.currentLocale)).editorial;
const channels = [
  { label: ed.email, href: 'mailto:' + site.email, text: site.email, external: false },
  ...[['GitHub', resolveValue(site.github)], ['LinkedIn', resolveValue(site.linkedin)]].flatMap(([label, href]) =>
    label && href ? [{ label, href, text: new URL(href).pathname.split('/').filter(Boolean).at(-1), external: true }] : []),
];
---

<section class="contact" id="contacto" aria-labelledby="contact-title">
  <div class="wrap">
    <div class="contact-plate">
      <div class="sec-head"><span class="label">{ed.contactLabel}</span><span class="label">ES · EN</span></div>
      <div class="contact-grid">
        <div class="left">
          <h2 class="h2" id="contact-title">{ed.contactTitle}</h2>
          <p class="lead">{ed.contactBody}</p>
          <WhatsAppLink inline />
          <p class="localtime mono">
            {ed.localTime} <b data-clock>--:--</b>.
            <span data-mood data-night={ed.night} data-morning={ed.morning} data-work={ed.working} data-late={ed.late}></span>
          </p>
        </div>
        <ul class="channels" role="list">
          {channels.map(({ label, href, text, external }) => (
            <li><a {href} target={external ? '_blank' : undefined} rel={external ? 'noopener' : undefined}>
              <span class="label">{label}</span><span>{text}</span><i aria-hidden="true">{external ? '↗' : '→'}</i>
            </a></li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>

<script>
  const clocks = document.querySelectorAll('[data-clock]');
  const mood = document.querySelector<HTMLElement>('[data-mood]');
  const format = new Intl.DateTimeFormat('en-GB', {
    timeZone: 'America/Asuncion', hour: '2-digit', minute: '2-digit',
    hourCycle: 'h23',
  });
  function tick() {
    const { hour, minute } = Object.fromEntries(
      format.formatToParts(new Date()).map(({ type, value }) => [type, value]),
    );
    clocks.forEach((clock) => { clock.textContent = hour + ':' + minute; });
    if (mood) {
      const h = Number(hour);
      mood.textContent = mood.dataset[h < 7 ? 'night' : h < 13 ? 'morning' : h < 20 ? 'work' : 'late'] ?? '';
    }
    window.setTimeout(tick, 60000 - Date.now() % 60000);
  }
  tick();
</script>
