---
import { site, whatsappHref, resolveValue } from '../config/site';

const email = resolveValue(site.email);
const hasWhatsapp = resolveValue(site.whatsapp) !== null;
---

<section id="contacto" class="contact section" aria-labelledby="contacto-title">
  <div class="section-inner layout">
    <h2 id="contacto-title">
      <span class="line">Tu próximo proyecto</span>
      <span class="line accent">empieza con un hola.</span>
    </h2>

    <div class="body">
      <p>¿Tenés un negocio, una idea a medio armar o solo querés consultar? Escribime.</p>

      <div class="actions">
        {hasWhatsapp && (
          <a class="btn btn-lg wa" href={whatsappHref()} target="_blank" rel="noopener noreferrer">
            Escribime por WhatsApp
          </a>
        )}
        {email && <a class="mail" href={`mailto:${email}`}>{email}</a>}
      </div>
    </div>
  </div>
</section>

<style>
  .contact {
    background-color: var(--color-bg-contact);
    color: var(--color-text-contact);
  }

  .layout {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
    gap: var(--space-xl) var(--space-2xl);
    align-items: end;
    padding-block: var(--space-xl);
  }

  h2 {
    font-family: 'Satoshi', system-ui, sans-serif;
    font-weight: 900;
    font-size: clamp(2.5rem, 6.5vw, 6rem);
    line-height: 1.02;
    letter-spacing: -0.03em;
  }

  .line {
    display: block;
  }

  .accent {
    font-family: 'Instrument Serif', Georgia, serif;
    font-style: italic;
    font-weight: 400;
    color: var(--color-text-contact-link);
  }

  .body {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .body p {
    max-width: 38ch;
    font-size: clamp(1.125rem, 1.8vw, 1.375rem);
    line-height: 1.55;
  }

  .actions {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-md);
  }

  .wa {
    background-color: var(--color-text-contact-link);
    border-color: var(--color-text-contact-link);
    color: var(--color-bg-contact);
  }

  .wa:hover {
    background-color: #c9d0ff;
    border-color: #c9d0ff;
  }

  .mail {
    font-size: 1.0625rem;
    font-weight: 500;
    color: var(--color-text-contact-link);
    text-decoration: underline;
    text-underline-offset: 4px;
    overflow-wrap: anywhere;
  }

  .mail:focus-visible,
  .wa:focus-visible {
    outline-color: var(--color-text-contact-link);
  }

  @media (max-width: 899px) {
    .layout {
      grid-template-columns: minmax(0, 1fr);
      align-items: start;
    }
  }

  @media (max-width: 699px) {
    .layout {
      padding-block: var(--space-lg);
    }

    .wa {
      width: 100%;
    }
  }
</style>
