---
import { localeOf } from '../i18n/routes';
import { t } from '../i18n/ui';
import { site } from '../config/site';

const ui = t(localeOf(Astro.currentLocale));
---

<footer class="ftr">
  <div class="wrap mono">
    <span>© {new Date().getUTCFullYear()} {site.name} · {site.location.split(',')[0]}</span>
    <a href="#top">{ui.editorial.top} ↑</a>
  </div>
</footer>
