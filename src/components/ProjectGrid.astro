---
import { FILTERS, getFeatured, getOthers } from '../lib/projects';
import ProjectCard from './ProjectCard.astro';
import ProjectMini from './ProjectMini.astro';

const featured = await getFeatured();
const others = await getOthers();
---

<section id="proyectos" class="section" aria-labelledby="proyectos-title">
  <div class="section-inner">
    <header class="head">
      <h2 id="proyectos-title" class="section-title">Proyectos</h2>
      <p class="section-lead">
        Lo que construí, con su estado real: en producción, entregado, en desarrollo o demo.
      </p>
    </header>

    <!-- Los filtros solo aparecen cuando corre JS (sin JS se ven todos los proyectos) -->
    <div id="filters-wrap" hidden>
      <div class="filters" role="group" aria-label="Filtrar proyectos por categoría">
        {FILTERS.map((f) => (
          <button type="button" class="chip" data-filter={f.id} aria-pressed={f.id === 'all' ? 'true' : 'false'}>
            {f.label}
          </button>
        ))}
      </div>
    </div>
    <p id="filter-status" class="sr-only" role="status" aria-live="polite"></p>

    <div id="featured-block">
      <ul class="featured-grid">
        {featured.map((p, i) => (
          <li data-cats={p.data.category.join(' ')} data-group="featured">
            <ProjectCard project={p} eager={i === 0} />
          </li>
        ))}
      </ul>
    </div>

    <div id="more-block" class="more">
      <h3 class="more-title">Más proyectos</h3>
      <ul class="mini-grid">
        {others.map((p) => (
          <li data-cats={p.data.category.join(' ')} data-group="more">
            <ProjectMini project={p} />
          </li>
        ))}
      </ul>
    </div>

    <p id="projects-empty" class="empty" hidden>
      Todavía no hay proyectos en esta categoría.
      <button type="button" class="link-btn" data-filter="all">Ver todos</button>
    </p>
  </div>
</section>

<style>
  .head {
    margin-bottom: var(--space-lg);
  }

  /* --- Filtros --- */
  .filters {
    display: flex;
    gap: 0.5rem;
    margin-bottom: var(--space-lg);
    padding: 0.35rem 0.25rem 0.5rem;
    overflow-x: auto;
    scroll-snap-type: x proximity;
    scrollbar-width: none;
  }

  .filters::-webkit-scrollbar {
    display: none;
  }

  .chip {
    flex-shrink: 0;
    scroll-snap-align: start;
    min-height: 44px;
    padding: 0 1.1rem;
    border: 2px solid #111;
    border-radius: 999px;
    background: #fff;
    font-family: inherit;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-text-primary);
    cursor: pointer;
    transition: background-color 0.15s, color 0.15s;
  }

  .chip[aria-pressed='true'] {
    background: #111;
    color: #fff;
  }

  @media (hover: hover) {
    .chip[aria-pressed='false']:hover {
      background: var(--color-bg-hero-to);
    }
  }

  /* --- Destacados --- */
  .featured-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-xl) var(--space-lg);
    list-style: none;
  }

  /* --- Más proyectos --- */
  .more {
    margin-top: var(--space-2xl);
  }

  .more-title {
    margin-bottom: var(--space-md);
    font-family: 'Satoshi', system-ui, sans-serif;
    font-weight: 900;
    font-size: clamp(1.5rem, 3vw, 2rem);
    letter-spacing: -0.02em;
  }

  .mini-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-md);
    padding-bottom: 4px; /* sombra dura de las cards */
    list-style: none;
  }

  .empty {
    padding: var(--space-lg);
    border: 2px dashed rgb(0 0 0 / 0.25);
    border-radius: 16px;
    text-align: center;
    color: var(--color-text-secondary);
  }

  .link-btn {
    margin-left: 0.5rem;
    border: 0;
    background: none;
    font: inherit;
    font-weight: 600;
    color: var(--color-accent);
    text-decoration: underline;
    cursor: pointer;
  }


  @media (max-width: 1024px) {
    .mini-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 699px) {
    .featured-grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .mini-grid {
      grid-template-columns: minmax(0, 1fr);
    }

    /* La fila de chips sangra hasta el borde: sin overflow de página */
    .filters {
      margin-inline: calc(var(--pad-mobile) * -1);
      padding-inline: var(--pad-mobile);
      scroll-padding-inline: var(--pad-mobile);
    }
  }
</style>

<script>
  const VALID = ['web', 'sistemas', 'integraciones', 'it', 'academico'];

  const root = document.getElementById('proyectos');
  const filtersWrap = document.getElementById('filters-wrap');
  const featuredBlock = document.getElementById('featured-block');
  const moreBlock = document.getElementById('more-block');
  const empty = document.getElementById('projects-empty');
  const status = document.getElementById('filter-status');
  const chips = Array.from(document.querySelectorAll<HTMLElement>('[data-filter].chip'));
  const items = Array.from(document.querySelectorAll<HTMLElement>('#proyectos li[data-cats]'));
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  function applyFilter(raw: string, { scroll = false } = {}) {
    const filter = VALID.includes(raw) ? raw : 'all';

    chips.forEach((c) => c.setAttribute('aria-pressed', String(c.dataset.filter === filter)));

    const shown = { featured: 0, more: 0 };
    items.forEach((li) => {
      const match = filter === 'all' || (li.dataset.cats ?? '').split(' ').includes(filter);
      li.hidden = !match;
      if (match) shown[li.dataset.group === 'featured' ? 'featured' : 'more']++;
    });

    if (featuredBlock) featuredBlock.hidden = shown.featured === 0;
    if (moreBlock) moreBlock.hidden = shown.more === 0;
    const total = shown.featured + shown.more;
    if (empty) empty.hidden = total > 0;
    if (status) {
      status.textContent = total === 1 ? 'Mostrando 1 proyecto' : `Mostrando ${total} proyectos`;
    }

    const url = new URL(window.location.href);
    if (filter === 'all') url.searchParams.delete('cat');
    else url.searchParams.set('cat', filter);
    history.replaceState(null, '', url);

    if (scroll && root) {
      root.scrollIntoView({ behavior: reducedMotion.matches ? 'auto' : 'smooth', block: 'start' });
    }
  }

  if (root && filtersWrap) {
    filtersWrap.hidden = false;
    chips.forEach((c) => c.addEventListener('click', () => applyFilter(c.dataset.filter ?? 'all')));
    empty?.querySelector<HTMLElement>('[data-filter]')?.addEventListener('click', () => applyFilter('all'));

    // Teclas del hero y links de Servicios emiten `kb:filter`
    document.addEventListener('kb:filter', (e) => {
      applyFilter((e as CustomEvent<{ filter: string }>).detail.filter, { scroll: true });
    });

    // Estado inicial desde ?cat=
    const initial = new URL(window.location.href).searchParams.get('cat');
    if (initial) applyFilter(initial);
  }
</script>
