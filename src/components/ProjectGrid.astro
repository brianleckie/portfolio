---
import { t } from '../i18n/ui';
import { caseHref, localeOf } from '../i18n/routes';
import { getFeatured, getOthers, shortTitle, slugOf, subtitleOf, summaryOf } from '../lib/projects';
import { projectFullImages, projectImages } from '../lib/project-images';
import { clean, cleanList } from '../lib/todo';
import DevicePair from './DevicePair.astro';
import ProjectDiagram from './ProjectDiagram.astro';

const locale = localeOf(Astro.currentLocale);
const ui = t(locale);
const ed = ui.editorial;
const number = (n: number) => String(n).padStart(2, '0');
const titles: Record<string, string> = { 'floreria-catalogo': ed.florists, 'dashboard-iot': ed.iot };
const featured = (await getFeatured()).map((project, i) => {
  const slug = slugOf(project);
  return {
    project, slug, n: number(i + 1), title: titles[slug] ?? shortTitle(project),
    href: caseHref(slug, locale), images: projectImages(project),
  };
});
const others = await getOthers();
---

<section class="sec" id="trabajos" aria-labelledby="work-title">
  <div class="wrap" id="proyectos">
    <div class="sec-head"><span class="label">{ed.selected}</span><span class="label">{ed.cases.replace('{count}', number(featured.length))}</span></div>
    <div class="proj-head">
      <h2 class="h2" id="work-title">{ed.work}</h2>
      <ol class="toc" role="list">
        {featured.map(({ slug, n, title }) => (
          <li><a href={'#c-' + slug}><span class="mono">{n}</span><span>{title}</span></a></li>
        ))}
      </ol>
    </div>
    <ol class="cases" role="list">
      {featured.map(({ project, slug, n, title, href, images }) => {
        const { data } = project;
        const role = clean(data.role);
        const stack = cleanList(data.stack).slice(0, 3).join(' · ');
        const florists = slug === 'floreria-catalogo';
        const flow = data.flow;
        const full = projectFullImages(project);
        const textOnly = !images.desktop && !images.mobile && !flow;
        const summary = summaryOf(project);
        const status = ui.status[data.status];
        const link = <a class="case-link" {href} aria-label={ed.viewCase + ' · ' + title}>{ed.viewCase} →</a>;
        return (
          <li class:list={['case', textOnly && 'text-only']} id={'c-' + slug} data-project={slug} data-status={data.status}>
            <div class="case-body">
              <div class="case-top"><span class="num">{n}</span><span class="status mono">{status}</span></div>
              <h3>{title}</h3>
              {!textOnly && <p class="desc">{slug === 'mbarete' && <><strong>{cleanList(data.results)[0]}</strong>{' '}</>}{summary}</p>}
              {(role || stack) && <dl class="meta">
                {role && <><dt>{ui.role}</dt><dd>{role}</dd></>}
                {stack && <><dt>{ui.stack}</dt><dd>{stack}</dd></>}
              </dl>}
            </div>
            {textOnly ? (
              <div class="text-aside"><p>{summary}</p>{link}</div>
            ) : flow && !images.desktop && !images.mobile ? (
              <div class="flow-wrap">
                <ProjectDiagram flow={flow} note={slug === 'ecodespensa' ? ed.ecoNote : undefined} />
                <div class="fig mono"><span>{ed.figure} {n} · {status}</span>{link}</div>
              </div>
            ) : (
              <figure class="media featured-shot">
                <DevicePair desktop={full.desktop ?? images.desktop} mobile={full.mobile ?? images.mobile}
                  fullDesktop={Boolean(full.desktop)} fullMobile={Boolean(full.mobile)} {title} accent={data.accent} />
                <figcaption class="fig mono"><span>{ed.figure} {n} · {florists ? ed.floristsCaption : status}</span>{link}</figcaption>
              </figure>
            )}
          </li>
        );
      })}
    </ol>
  </div>
</section>

<section class="sec" id="mas" aria-labelledby="more-title">
  <div class="wrap">
    <div class="sec-head"><span class="label">{ed.archive}</span><span class="label">{ed.more.replace('{count}', number(others.length))}</span></div>
    <div class="more-grid">
      <h2 class="h2" id="more-title">{ui.moreProjects}</h2>
      <ul class="more" role="list">
        {others.map((project) => {
          const slug = slugOf(project);
          const external = slug === 'cpo-tech' ? clean(project.data.links?.[0]?.url) : null;
          return <li data-project={slug} data-status={project.data.status}>
            <a href={external ?? caseHref(slug, locale)} target={external ? '_blank' : undefined} rel={external ? 'noopener' : undefined}>
              <strong>{titles[slug] ?? shortTitle(project)}</strong>
              <span class="d">{external ? ed.homeCpo : subtitleOf(project) ?? summaryOf(project)}</span>
              <span class="go" aria-hidden="true">{external ? '↗' : '→'}</span>
            </a>
          </li>;
        })}
      </ul>
    </div>
  </div>
</section>
