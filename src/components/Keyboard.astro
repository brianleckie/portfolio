---
import { whatsappHref } from '../config/site';
import { KEYS, ENTER } from '../config/keyboard';

// Nombre accesible = caption en minúscula con excepciones de siglas/tildes
const LABEL_OVERRIDES: Record<string, string> = { 'IT Y SOPORTE': 'IT y soporte' };
const labelFor = (caption: string) =>
  LABEL_OVERRIDES[caption] ?? caption.charAt(0) + caption.slice(1).toLowerCase();
---

<nav class="kb-section" aria-label="Teclado de navegación">
  <div class="kb" id="kb-wrapper">
    <div class="kb-stage" id="kb-stage">
      {KEYS.map((key) => (
        <a href={key.href} class="key" id={`key-${key.id}`} aria-label={labelFor(key.caption)} data-filter={key.filter ?? undefined}>
          <span class="key-face" aria-hidden="true">
            <span class="key-letter">{key.letter}</span>
            <span class="key-caption">{key.caption}</span>
          </span>
        </a>
      ))}
      <a href={whatsappHref()} target="_blank" rel="noopener noreferrer" class="key key-enter" id="key-Enter" aria-label="Hablemos por WhatsApp">
        <span class="key-face" aria-hidden="true">
          <svg class="key-enter-icon" viewBox="0 0 64 44" focusable="false"><path d="M54 5v21H12" /><path d="M24 13 11 26l13 13" /></svg>
          <span class="key-enter-caption">{ENTER.caption}</span>
        </span>
      </a>
    </div>
  </div>
</nav>

<style>
  /* u = lado de la tecla. Registrada: se resuelve una vez en .kb (px) y la heredan las teclas. */
  @property --u {
    syntax: '<length>';
    inherits: true;
    initial-value: 64px;
  }

  .kb-section {
    container: kb / inline-size;
    max-width: var(--max-w);
    margin: clamp(12px, 3svh, 32px) auto 0;
    padding: 0 var(--pad-desktop) clamp(12px, 2svh, 24px);
  }

  /* Desktop/tablet: arco de tokens.css; u limitado por ancho, por alto de pantalla (fold) y por un tope */
  .kb {
    --kb-pad-y: 10px; /* aire arriba/abajo para foco y sombra */
    --kb-stroke: 2px;
    --u: clamp(56px, min(100cqi / var(--kb-w), (100svh - var(--kb-reserve)) / var(--kb-h)), var(--kb-u-max));
  }

  /* Mobile: misma fórmula, arco más plano y apretado → tecla ≥ 56px a 360 */
  @container kb (max-width: 559.98px) {
    .kb {
      --kb-pitch: 1.12;
      --kb-tilt: 2.5;
      --kb-sag: 0.04;
      --kb-row: 1.14;
      --kb-y0: 0.501;
      --kb-enter-w: 3.24;
      --kb-enter-dy: 1.18;
      --kb-w: 5.565;
      --kb-h: 3.321;
      --kb-pad-y: 8px;
      --u: min(100cqi / var(--kb-w), 104px);
    }
  }

  @supports not (width: 1cqi) {
    .kb { --u: min((100vw - 64px) / 5.88, 140px); }
  }

  .kb-stage {
    position: relative;
    width: calc(var(--kb-w) * var(--u));
    height: calc(var(--kb-h) * var(--u) + 2 * var(--kb-pad-y));
    margin-inline: auto;
  }

  /* === Tecla: posición por fórmula. --i = lugar en la fila desde el centro, --row = 0|1 === */
  .key {
    --x: calc(var(--i) * var(--kb-pitch));
    --y: calc(var(--kb-y0) + var(--row) * var(--kb-row) + var(--kb-sag) * var(--i) * var(--i));
    --dz: 0px; /* hundimiento en el eje local */
    --drop: calc(var(--u) * 0.05); /* sombra dura */
    --seam: rgb(17 17 17 / 0.45);
    --bevel: rgb(255 255 255 / 0.4);
    position: absolute;
    left: calc(50% + (var(--x) - 0.5) * var(--u));
    top: calc(var(--kb-pad-y) + (var(--y) - 0.5) * var(--u));
    width: var(--u);
    height: var(--u);
    overflow: hidden;
    border: var(--kb-stroke) solid var(--kb-line);
    border-radius: calc(var(--u) * 0.22);
    background-color: var(--side);
    box-shadow:
      0 var(--drop) 0 var(--kb-line),
      0 calc(var(--u) * 0.16) calc(var(--u) * 0.2) calc(var(--u) * -0.08) rgb(29 32 51 / 0.3);
    color: var(--ink);
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
    transform: rotate(calc(var(--i) * var(--kb-tilt) * 1deg)) translateY(var(--dz));
    transition: transform 0.14s ease-out, box-shadow 0.14s ease-out;
  }

  /* Paredes: costuras diagonales en las esquinas inferiores + pared de abajo más oscura */
  .key::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to top left, transparent calc(50% - 1px), var(--seam) 0 calc(50% + 1px), transparent 0)
        left bottom / calc(var(--u) * 0.085 + 2px) calc(var(--u) * 0.2 + 2px) no-repeat,
      linear-gradient(to top right, transparent calc(50% - 1px), var(--seam) 0 calc(50% + 1px), transparent 0)
        right bottom / calc(var(--u) * 0.085 + 2px) calc(var(--u) * 0.2 + 2px) no-repeat,
      linear-gradient(to top, rgb(0 0 0 / 0.16), transparent 32%);
    pointer-events: none;
  }

  .key-face {
    position: absolute;
    inset: calc(var(--u) * 0.05) calc(var(--u) * 0.085) calc(var(--u) * 0.2);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    border: var(--kb-stroke) solid var(--kb-line);
    border-radius: calc(var(--u) * 0.16);
    background-color: var(--face);
    box-shadow:
      inset 0 calc(var(--u) * 0.03) 0 var(--bevel),
      inset 0 calc(var(--u) * -0.025) 0 rgb(0 0 0 / 0.12);
    pointer-events: none;
    transition: transform 0.14s ease-out;
  }

  .key-letter {
    font-family: 'Satoshi', system-ui, sans-serif;
    font-size: calc(var(--u) * 0.44);
    font-weight: 900;
    line-height: 0.9;
    letter-spacing: -0.02em;
  }

  /* Caption: 0px (oculto) si u < 116px; si no, ≥ 10px. El nombre accesible está en aria-label. */
  .key-caption {
    max-width: 100%;
    margin-top: 0.4em;
    padding-inline: 0.2em;
    font-family: 'Inter Variable', system-ui, sans-serif;
    font-size: clamp(0px, (var(--u) - 115.5px) * 1000, max(10px, var(--u) * 0.078));
    font-weight: 650;
    line-height: 1.12;
    letter-spacing: 0.03em;
    text-align: center;
    text-transform: uppercase;
    text-wrap: balance;
  }

  /* === Enter: ancho, horizontal, centrado bajo el arco === */
  .key-enter {
    --y: calc(var(--kb-y0) + var(--kb-row) + var(--kb-enter-dy));
    --seam: rgb(255 255 255 / 0.2);
    --bevel: rgb(255 255 255 / 0.14);
    left: calc(50% - var(--kb-enter-w) * var(--u) / 2);
    width: calc(var(--kb-enter-w) * var(--u));
    border-radius: calc(var(--u) * 0.24);
  }

  .key-enter .key-face {
    flex-direction: row;
    align-items: flex-end;
    justify-content: space-between;
    padding: calc(var(--u) * 0.08) calc(var(--u) * 0.12);
  }

  .key-enter-icon {
    align-self: flex-start;
    width: calc(var(--u) * 0.58);
    height: calc(var(--u) * 0.4);
    fill: none;
    stroke: currentColor;
    stroke-width: 7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .key-enter-caption {
    font-family: 'Inter Variable', system-ui, sans-serif;
    font-size: max(11px, var(--u) * 0.085);
    font-weight: 700;
    line-height: 1;
    letter-spacing: 0.14em;
    color: var(--key-enter-caption);
  }

  /* === Lugar y color de cada tecla === */
  #key-L  { --i: -1.5; --row: 0; --face: var(--key-l-face);  --side: var(--key-l-side);  --ink: var(--key-l-ink); }
  #key-E  { --i: -0.5; --row: 0; --face: var(--key-e-face);  --side: var(--key-e-side);  --ink: var(--key-e-ink); }
  #key-K1 { --i: 0.5;  --row: 0; --face: var(--key-k1-face); --side: var(--key-k1-side); --ink: var(--key-k1-ink); }
  #key-I  { --i: 1.5;  --row: 0; --face: var(--key-i-face);  --side: var(--key-i-side);  --ink: var(--key-i-ink); }
  #key-W  { --i: -2;   --row: 1; --face: var(--key-w-face);  --side: var(--key-w-side);  --ink: var(--key-w-ink); }
  #key-O  { --i: -1;   --row: 1; --face: var(--key-o-face);  --side: var(--key-o-side);  --ink: var(--key-o-ink); }
  #key-R  { --i: 0;    --row: 1; --face: var(--key-r-face);  --side: var(--key-r-side);  --ink: var(--key-r-ink); }
  #key-K2 { --i: 1;    --row: 1; --face: var(--key-k2-face); --side: var(--key-k2-side); --ink: var(--key-k2-ink); }
  #key-S  { --i: 2;    --row: 1; --face: var(--key-s-face);  --side: var(--key-s-side);  --ink: var(--key-s-ink); }
  #key-Enter { --i: 0; --row: 1; --face: var(--key-enter-face); --side: var(--key-enter-side); --ink: var(--key-enter-ink); }

  /* === Estados (todos en el eje local) === */
  @media (hover: hover) {
    .key:hover { --dz: calc(var(--u) * 0.015); z-index: 1; }
    .key:hover .key-face { transform: translateY(calc(var(--u) * 0.045)); }
  }

  .key:focus-visible {
    --dz: calc(var(--u) * 0.015);
    z-index: 2;
    outline: 3px solid var(--color-accent);
    outline-offset: 4px;
  }
  .key:focus-visible .key-face { transform: translateY(calc(var(--u) * 0.045)); }

  .key.is-pressed,
  .key:active {
    --dz: calc(var(--u) * 0.03);
    --drop: calc(var(--u) * 0.02);
  }
  .key.is-pressed .key-face,
  .key:active .key-face { transform: translateY(calc(var(--u) * 0.07)); }

  @media (max-width: 1024px) { .kb-section { padding-inline: var(--pad-tablet); } }
  @media (max-width: 700px)  { .kb-section { padding-inline: var(--pad-mobile); } }

  @media (prefers-reduced-motion: reduce) {
    .key, .key-face { transition: none; }
  }
</style>

<script>
  import { bindFilterLinks } from '../scripts/filter-links';

  (() => {
    const root = document.getElementById('kb-wrapper');
    const stage = document.getElementById('kb-stage');
    if (!root || !stage) return;

    // Secuencia (SPEC §6): L, E, K, I, W, O, R, K, S, Enter + reposo. Nunca más de una tecla abajo.
    const ORDER = ['L', 'E', 'K1', 'I', 'W', 'O', 'R', 'K2', 'S', 'Enter'];
    const PRESS_MS = 170;
    const STEP_MS = 340;
    const REST_MS = 1400;
    const keys = ORDER.map((id) => document.getElementById(`key-${id}`)).filter((k): k is HTMLElement => k !== null);
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
    const ac = new AbortController();
    const { signal } = ac;

    let idx = 0;
    let stepTimer = 0;
    let releaseTimer = 0;
    let running = false;
    let inView = false;
    let pointerIn = false;
    let focusIn = false;

    function releaseAll() {
      window.clearTimeout(releaseTimer);
      keys.forEach((k) => k.classList.remove('is-pressed'));
    }

    function tick() {
      const key = keys[idx];
      releaseAll();
      key.classList.add('is-pressed');
      releaseTimer = window.setTimeout(() => key.classList.remove('is-pressed'), PRESS_MS);
      idx = (idx + 1) % keys.length;
      stepTimer = window.setTimeout(tick, idx === 0 ? REST_MS : STEP_MS);
    }

    // Corre solo si se ve, nadie interactúa, la pestaña está visible y no hay reduced-motion.
    function sync() {
      const should = keys.length > 0 && inView && !pointerIn && !focusIn && !document.hidden && !reduced.matches;
      if (should === running) return;
      running = should;
      window.clearTimeout(stepTimer);
      if (should) stepTimer = window.setTimeout(tick, STEP_MS);
      else releaseAll();
    }

    stage.addEventListener('pointerenter', () => { pointerIn = true; sync(); }, { signal });
    stage.addEventListener('pointerleave', () => { pointerIn = false; sync(); }, { signal });
    root.addEventListener('focusin', () => { focusIn = true; sync(); }, { signal });
    root.addEventListener('focusout', (e) => { focusIn = root.contains(e.relatedTarget as Node | null); sync(); }, { signal });
    document.addEventListener('visibilitychange', sync, { signal });
    reduced.addEventListener('change', sync, { signal });

    const io = new IntersectionObserver(([entry]) => { inView = entry.isIntersecting; sync(); }, { threshold: 0.1 });
    io.observe(stage);

    document.addEventListener('astro:before-swap', () => {
      ac.abort();
      io.disconnect();
      running = false;
      window.clearTimeout(stepTimer);
      releaseAll();
    }, { once: true });

    // Teclas con data-filter: emiten `kb:filter`; ProjectGrid aplica el filtro y hace scroll.
    bindFilterLinks(root);
  })();
</script>
