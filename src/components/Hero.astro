---
import { localeOf } from '../i18n/routes';
import { t } from '../i18n/ui';
import { site } from '../config/site';
import HeroFigure from './HeroFigure.astro';
import WhatsAppLink from './WhatsAppLink.astro';

const ui = t(localeOf(Astro.currentLocale));
const ed = ui.editorial;
const [firstName, ...lastName] = site.name.split(' ');
---

<section class="hero" id="hero" aria-labelledby="hero-title">
  <div class="wrap">
    <p class="ref-note" data-ref-note hidden>{ed.referral}</p>
    <div class="hero-grid">
      <div class="hero-l">
        <h1 class="h1" id="hero-title" data-typing={ed.typing}>
          <span class="sr-only">{site.name}</span>
          <span class="hero-name-reserve" aria-hidden="true"><span>{firstName}</span>{' '}<span>{lastName.join(' ')}</span></span>
          <span class="hero-name-visual" data-typing-visual aria-hidden="true"><span>{firstName}</span>{' '}<span>{lastName.join(' ')}</span></span>
        </h1>
        <p class="role">{ui.siteRole}.</p>
        <p class="intro">{ed.intro}</p>
        <div class="now">
          <span class="label">{ed.now}</span>
          <p>{ui.roleIntro} {site.employer} {ui.roleContinuation} <span>{site.company}</span></p>
        </div>
        <div class="cta-row">
          <WhatsAppLink inline />
          <a class="link-arrow" href="#trabajos">{ed.viewWork} ↓</a>
        </div>
      </div>
      <HeroFigure />
    </div>
  </div>
</section>

<script>
  const title = document.querySelector<HTMLElement>('[data-typing]');
  const display = title?.querySelector<HTMLElement>('[data-typing-visual]');
  const reservation = title?.querySelector('.hero-name-reserve');
  const reduced = matchMedia('(prefers-reduced-motion: reduce)');
  if (title && display && reservation && !reduced.matches) {
    const joke = title.dataset.typing ?? '';
    const words = Array.from(reservation.querySelectorAll('span'), (word) => word.textContent ?? '');
    const name = words.join(' ');
    let timer: number;
    const finish = () => {
      clearTimeout(timer);
      display.replaceChildren(...Array.from(reservation.childNodes, (node) => node.cloneNode(true)));
      display.classList.remove('is-typing');
    };
    const steps = [
      ...Array.from(joke, (_, i) => ({ text: joke.slice(0, i + 1), delay: i === joke.length - 1 ? 1200 : 58 })),
      ...Array.from(joke, (_, i) => ({ text: joke.slice(0, joke.length - i - 1), delay: 42 })),
      ...Array.from(name, (_, i) => ({ text: name.slice(0, i + 1), delay: 60 })),
    ];
    function play(index: number) {
      const step = steps[index];
      if (!step || reduced.matches || document.hidden) return finish();
      const [first, ...rest] = step.text.split(' ');
      const lines = rest.length ? [first, rest.join(' ')] : [first];
      display!.replaceChildren(...lines.flatMap((line, i) => {
        const element = document.createElement('span');
        element.textContent = line;
        return i ? [document.createTextNode(' '), element] : [element];
      }));
      timer = window.setTimeout(() => play(index + 1), step.delay);
    }
    display.classList.add('is-typing');
    play(0);
    reduced.addEventListener('change', finish, { once: true });
    document.addEventListener('visibilitychange', () => { if (document.hidden) finish(); });
  }

  const source = new URLSearchParams(location.search).get('ref');
  const referrer = document.referrer && new URL(document.referrer).origin;
  if (source || (referrer && referrer !== location.origin)) {
    document.querySelector('[data-ref-note]')?.removeAttribute('hidden');
  }
</script>
