---
const TEXT = "Catálogos con pedido por WhatsApp. · Sistemas a medida. · Integraciones que ahorran horas. · Webs que se ven bien en el celular. · Elegí una tecla.";
---

<div class="marquee-strip">
  <div class="marquee-track" id="marquee-track">
    <div class="marquee-group" id="marquee-g1">
      <span class="marquee-item">{TEXT}<span class="marquee-sep" aria-hidden="true">·</span></span>
    </div>
    <div class="marquee-group" id="marquee-g2" aria-hidden="true">
      <span class="marquee-item">{TEXT}<span class="marquee-sep">·</span></span>
    </div>
  </div>
</div>

<style>
  .marquee-strip {
    background-color: var(--color-marquee-bg);
    color: var(--color-marquee-text);
    overflow: hidden;
    padding: 1.25rem 0;
    width: 100%;
  }

  .marquee-track {
    display: flex;
    width: max-content;
    will-change: transform;
  }

  .marquee-group {
    display: flex;
    flex-shrink: 0;
    font-family: 'Instrument Serif', Georgia, serif;
    font-style: italic;
    font-size: clamp(1.375rem, 2.5vw, 2rem);
    line-height: 1.3;
  }

  .marquee-item {
    flex-shrink: 0;
    white-space: nowrap;
  }

  .marquee-sep {
    margin-inline: 1.1em;
  }

  /* Reduced motion: estático, el mensaje puede envolver en varias líneas */
  @media (prefers-reduced-motion: reduce) {
    .marquee-strip {
      overflow: visible;
      padding-inline: var(--pad-mobile);
    }

    .marquee-track {
      display: block;
      width: auto;
      will-change: auto;
    }

    .marquee-group {
      display: block;
    }

    .marquee-item {
      white-space: normal;
    }

    .marquee-sep,
    #marquee-g2 {
      display: none;
    }
  }
</style>

<script>
  (() => {
    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)');
    const strip = document.querySelector<HTMLElement>('.marquee-strip');
    const track = document.getElementById('marquee-track');
    const g1 = document.getElementById('marquee-g1');
    const g2 = document.getElementById('marquee-g2');
    const template = g1?.firstElementChild as HTMLElement | null | undefined;
    if (!strip || !track || !g1 || !g2 || !template) return;
    if (prefersReduced.matches) return;

    const SPEED = 50; // px/s
    const MAX_DT = 50; // ms, evita saltos al volver de una pestaña oculta

    let raf = 0;
    let last: number | null = null;
    let offset = 0;
    let groupWidth = 0;
    let reps = 1;
    let visible = true;

    // Cada grupo repite la frase hasta ser al menos tan ancho como el viewport,
    // así dos grupos siempre cubren la ventana sin huecos (monitores grandes incluidos).
    function fill() {
      const unit = template!.getBoundingClientRect().width;
      if (!unit) return;
      const needed = Math.max(1, Math.ceil(document.documentElement.clientWidth / unit));
      if (needed !== reps) {
        reps = needed;
        while (g1!.children.length > 1) g1!.lastElementChild?.remove();
        g2!.replaceChildren();
        for (let i = 1; i < reps; i++) {
          const clone = template!.cloneNode(true) as HTMLElement;
          clone.setAttribute('aria-hidden', 'true');
          g1!.appendChild(clone);
        }
        for (let i = 0; i < reps; i++) g2!.appendChild(template!.cloneNode(true));
      }
      groupWidth = g1!.getBoundingClientRect().width;
      if (groupWidth > 0) offset %= groupWidth;
    }

    function step(ts: number) {
      if (last === null) last = ts;
      const dt = Math.min(ts - last, MAX_DT);
      last = ts;
      offset += SPEED * (dt / 1000);
      if (groupWidth > 0 && offset >= groupWidth) offset -= groupWidth;
      track!.style.transform = `translateX(${-offset}px)`;
      raf = requestAnimationFrame(step);
    }

    function stopRaf() {
      cancelAnimationFrame(raf);
      last = null;
    }

    function startRaf() {
      if (!visible || document.hidden || prefersReduced.matches) return;
      stopRaf();
      raf = requestAnimationFrame(step);
    }

    const ro = new ResizeObserver(fill);
    ro.observe(strip);
    ro.observe(template); // cambia de ancho cuando carga Instrument Serif
    fill();
    startRaf();

    const io = new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      if (visible) startRaf(); else stopRaf();
    }, { threshold: 0 });
    io.observe(strip);

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) stopRaf(); else startRaf();
    });

    prefersReduced.addEventListener('change', e => {
      if (e.matches) {
        stopRaf();
        track!.style.transform = '';
      } else {
        startRaf();
      }
    });

    document.addEventListener('astro:before-swap', () => {
      stopRaf();
      ro.disconnect();
      io.disconnect();
    });
  })();
</script>
