---
import { localeOf } from '../i18n/routes';
import { t } from '../i18n/ui';
import type { Flow } from '../lib/projects';

interface Props { flow: Flow; note?: string }
const { flow, note = flow.note } = Astro.props;
const ui = t(localeOf(Astro.currentLocale));
---

<figure class="diagram" data-diagram>
  <figcaption class="label">{ui.diagram}{flow.title && <> · {flow.title}</>}</figcaption>
  <ol class="flow" role="list" style={`--steps:${flow.steps.length}`}>
    {flow.steps.map((step, i) => (
      <li class:list={['node', step.branches && 'branch-node']}>
        <b>{step.label}</b>
        {step.detail && <span>{step.detail}</span>}
        {step.branches && (
          <ul class="branches" role="list">
            {step.branches.map(({ label, detail }) => (
              <li>{step.code ? <code>{label}</code> : label}{detail && <small>{detail}</small>}</li>
            ))}
          </ul>
        )}
        {i < flow.steps.length - 1 && <span class="connector" aria-hidden="true"></span>}
      </li>
    ))}
  </ol>
  {note && <p class="flow-note">{note}</p>}
</figure>

<style>
  .diagram { container-type: inline-size; --line: var(--acc, var(--ink)); }
  .flow { display: grid; gap: 22px; list-style: none; padding: 0; margin: 8px 0 0; }
  .node {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0 10px;
    border: 1px solid var(--ink);
    background: var(--card);
    padding: 8px 12px;
    min-width: 0;
    overflow-wrap: anywhere;
  }
  .node > b { font-size: 17px; font-weight: 600; }
  .node > span, .branches { font: 14px/1.4 var(--mono); color: var(--muted); }
  .branch-node { border: 1px dashed var(--line); background: transparent; }
  .branch-node > b { color: var(--line); }
  .branches {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px;
    flex-basis: 100%;
    margin: 8px 0 0;
    padding: 0;
    list-style: none;
  }
  .branches li { border: 1px solid var(--line); background: var(--card); padding: 5px 6px; color: var(--ink); }
  .branches code { font: inherit; }
  .branches small { display: block; color: var(--muted); font-size: 14px; }
  .connector { position: absolute; top: calc(100% + 2px); left: calc(50% - .5ch); }
  .connector::before { content: '↓'; color: var(--line); }
  .flow-note { margin-top: 12px; padding-left: 12px; border-left: 2px solid var(--line); font-size: 15px; }
  @container (min-width: 610px) {
    .flow { grid-template-columns: repeat(var(--steps), minmax(0, 1fr)); }
    .node { display: block; padding: 12px; }
    .node > span { display: block; margin-top: 4px; }
    .branch-node { margin-inline: -5px; }
    .branch-node .branches { grid-template-columns: 1fr; }
    .connector { top: 50%; left: auto; right: -17px; }
    .connector::before { content: '→'; }
  }
</style>
