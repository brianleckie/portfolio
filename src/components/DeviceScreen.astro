---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { localeOf } from '../i18n/routes';
import { t } from '../i18n/ui';

interface Props {
  image?: ImageMetadata;
  title: string;
  device: 'desktop' | 'mobile';
  full?: boolean;
  eager?: boolean;
  deferred?: boolean;
  cycle?: boolean;
  bar?: ImageMetadata;
}
const { image, title, device, full = false, eager = false, deferred = false, cycle = false, bar } = Astro.props;
const ed = t(localeOf(Astro.currentLocale)).editorial;
const mobile = device === 'mobile';
const alt = (mobile ? ed.screenMobile : ed.screenDesktop).replace('{title}', title);
const output = image && await getImage({
  src: image, width: Math.min(image.width, mobile ? 430 : 1080), format: 'webp', quality: 74,
});
const barOutput = bar && await getImage({ src: bar, width: Math.min(bar.width, 430), format: 'webp', quality: 85 });
---

{output && (
  <div class:list={['device', mobile ? 'device-phone' : 'device-laptop']}>
    {mobile && <>
      <span class="phone-edge" aria-hidden="true"></span>
      <span class="phone-side" aria-hidden="true"></span>
      <span class="phone-buttons" aria-hidden="true"></span>
    </>}
    <div class="device-front">
      <div class="device-window">
        <img class:list={['device-image', cycle && 'device-scroll', !full && 'device-crop']}
        src={deferred ? undefined : output.src} data-device-src={deferred ? output.src : undefined}
        width={output.attributes.width} height={output.attributes.height} {alt}
        loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : undefined} decoding="async" />
        {barOutput && <img class="device-bar" src={barOutput.src} width={barOutput.attributes.width}
          height={barOutput.attributes.height} alt="" aria-hidden="true" loading={eager ? 'eager' : 'lazy'} decoding="async" />}
      </div>
    </div>
  </div>
)}
