---
import { t } from '../i18n/ui';
import { localeOf } from '../i18n/routes';
const ui = t(localeOf(Astro.currentLocale));
const steps = [
  { title: ui.step1, text: ui.step1Body },
  { title: ui.step2, text: ui.step2Body, featured: true },
  { title: ui.step3, text: ui.step3Body },
  { title: ui.step4, text: ui.step4Body },
];
---

<section id="proceso" class="section" aria-labelledby="proceso-title">
  <div class="section-inner">
    <h2 id="proceso-title" class="section-title">{ui.process}</h2>
    <p class="section-lead">{ui.processLead}</p>

    <ol class="steps">
      {steps.map((s, i) => (
        <li class:list={['step', { featured: s.featured }]}>
          <span class="num" aria-hidden="true">{i + 1}</span>
          <h3>{s.title}</h3>
          <p>{s.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .steps {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-md);
    margin-top: var(--space-xl);
    padding-block: 12px 6px; /* aire para el paso destacado y la sombra */
    list-style: none;
  }

  .step {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    min-width: 0;
    padding: var(--space-lg) var(--space-md);
    border: 2px solid rgb(0 0 0 / 0.14);
    border-radius: 20px;
    background: #fff;
  }

  .num {
    font-family: 'Satoshi', system-ui, sans-serif;
    font-weight: 900;
    font-size: 3rem;
    line-height: 1;
    color: rgb(0 0 0 / 0.18);
  }

  h3 {
    font-family: 'Satoshi', system-ui, sans-serif;
    font-weight: 900;
    font-size: 1.375rem;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--color-text-primary);
  }

  p {
    color: var(--color-text-secondary);
    line-height: 1.55;
  }

  /* Paso 2: el diferencial (demo-first) */
  .featured {
    border-color: #111;
    background: var(--color-accent);
    box-shadow: 0 6px 0 #000;
    transform: translateY(-8px);
  }

  .featured .num {
    color: rgb(255 255 255 / 0.55);
  }

  .featured h3,
  .featured p {
    color: #fff;
  }

  @media (max-width: 1100px) {
    .steps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 699px) {
    .steps {
      grid-template-columns: minmax(0, 1fr);
      margin-top: var(--space-lg);
    }

    .featured {
      transform: none;
    }
  }
</style>
