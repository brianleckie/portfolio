---
import { getServices } from '../config/services';
import { localeOf } from '../i18n/routes';
import { t } from '../i18n/ui';

const locale = localeOf(Astro.currentLocale);
const ui = t(locale);
---

<section class="sec" id="servicios" aria-labelledby="services-title">
  <div class="wrap">
    <div class="sec-head"><span class="label">{ui.services}</span><span class="label">{ui.editorial.demoFirst}</span></div>
    <div class="svc-grid">
      <div class="left">
        <h2 class="h2" id="services-title">{ui.process}</h2>
        <p class="svc-lead">{ui.editorial.demoLead}</p>
        <p>{ui.editorial.demoBody}</p>
      </div>
      <ol class="svc" role="list">
        {getServices(locale).map(({ title, description }, i) => (
          <li><span class="n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span><b>{title}</b><p>{description}</p></li>
        ))}
      </ol>
    </div>
  </div>
</section>
